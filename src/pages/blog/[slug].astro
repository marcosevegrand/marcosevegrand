---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../config';
import { tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const showToc = (entry.data.toc ?? true) && toc.length > 0;
---

<Base
  title={entry.data.title}
  description={entry.data.description ?? entry.data.summary}
  math={entry.data.math}
  isArticle
>
  <article class="article" data-pagefind-body>
    <header class="article-header">
      {
        entry.data.date && (
          <p class="post-kind">
            <time datetime={entry.data.date.toISOString().slice(0, 10)} data-pagefind-meta="date">
              {formatDate(entry.data.date)}
            </time>
          </p>
        )
      }
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      {entry.data.summary && <p class="lead">{entry.data.summary}</p>}
      {
        entry.data.tags.length > 0 && (
          <p class="post-tags">
            {entry.data.tags.map((tag) => (
              <a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
            ))}
          </p>
        )
      }
    </header>

    {
      showToc && (
        <details class="toc">
          <summary>On this page</summary>
          <ul>
            {toc.map((heading) => (
              <li class:list={[`toc-depth-${heading.depth}`]}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <div class="content">
      <Content />
    </div>
  </article>

  <script>
    // Progressive enhancements for articles: section links, copy buttons,
    // click-to-zoom images, and client-rendered Mermaid diagrams.
    const root = document.querySelector<HTMLElement>('.content');
    if (root) {
      addHeadingAnchors(root);
      addCopyButtons(root);
      addImageZoom(root);
      renderMermaid(root);
    }

    function addHeadingAnchors(scope: HTMLElement) {
      for (const heading of scope.querySelectorAll<HTMLElement>('h2[id], h3[id]')) {
        const anchor = document.createElement('a');
        anchor.className = 'heading-anchor';
        anchor.href = `#${heading.id}`;
        anchor.setAttribute('aria-label', 'Link to this section');
        anchor.textContent = '#';
        heading.append(anchor);
      }
    }

    function addCopyButtons(scope: HTMLElement) {
      for (const button of scope.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        const label = button.textContent ?? 'Copy';
        button.addEventListener('click', async () => {
          const pre = button.closest('.code-block')?.querySelector('pre');
          if (!pre) return;
          try {
            await navigator.clipboard.writeText((pre.textContent ?? '').replace(/\n$/, ''));
            button.textContent = 'Copied';
            button.classList.add('is-copied');
            window.setTimeout(() => {
              button.textContent = label;
              button.classList.remove('is-copied');
            }, 1600);
          } catch {
            /* Clipboard blocked; leave the code selectable by hand. */
          }
        });
      }
    }

    function addImageZoom(scope: HTMLElement) {
      const links = Array.from(scope.querySelectorAll<HTMLAnchorElement>('a.image-zoom'));
      if (links.length === 0) return;

      const overlay = document.createElement('div');
      overlay.className = 'lightbox';
      overlay.hidden = true;
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      const image = document.createElement('img');
      overlay.append(image);
      document.body.append(overlay);

      const close = () => {
        overlay.hidden = true;
        image.removeAttribute('src');
      };
      const open = (link: HTMLAnchorElement) => {
        const src = link.getAttribute('href');
        if (!src) return;
        image.src = src;
        image.alt = link.querySelector('img')?.getAttribute('alt') ?? '';
        overlay.hidden = false;
      };

      for (const link of links) {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          open(link);
        });
      }
      overlay.addEventListener('click', close);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !overlay.hidden) close();
      });
    }

    function renderMermaid(scope: HTMLElement) {
      const fences = scope.querySelectorAll<HTMLElement>('pre > code.language-mermaid');
      if (fences.length === 0) return;

      fences.forEach((code) => {
        const pre = code.parentElement;
        if (!pre) return;
        const target = document.createElement('pre');
        target.className = 'mermaid';
        target.textContent = code.textContent ?? '';
        pre.replaceWith(target);
      });

      // Kept in a variable so neither TypeScript nor Vite resolves the CDN URL
      // at build time; the diagram module is fetched at runtime.
      const mermaidUrl = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
      import(/* @vite-ignore */ mermaidUrl)
        .then(({ default: mermaid }) => {
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            theme: 'base',
            themeVariables: {
              fontFamily: 'Hanken Grotesk Variable, ui-sans-serif, system-ui, sans-serif',
              fontSize: '15px',
              primaryColor: '#efe9df',
              primaryTextColor: '#1c1916',
              primaryBorderColor: '#e0d8cb',
              lineColor: '#6f665c',
              tertiaryColor: '#fffdf9',
              clusterBkg: '#fffdf9',
              clusterBorder: '#e0d8cb',
            },
          });
          return mermaid.run({ querySelector: '.mermaid' });
        })
        .catch(() => {
          /* Leave the raw fence text visible if the CDN or a diagram fails. */
        });
    }
  </script>
</Base>
