---
import Base from '../layouts/Base.astro';
import ContactIcon from '../components/ContactIcon.astro';
import CertificationLibrary from '../components/CertificationLibrary.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import { getCollection } from 'astro:content';
import { SOCIALS, SITE } from '../config';

const entries = (await getCollection('timeline')).sort(
  (a, b) => (b.data.start ?? '').localeCompare(a.data.start ?? '') || a.data.order - b.data.order,
);

const experience = entries.filter((entry) => entry.data.kind === 'work' && entry.data.featured);
const education = entries.filter((entry) => entry.data.kind === 'education');
const linkedIn = SOCIALS.find((social) => social.label === 'LinkedIn')?.href;
---

<Base title="About" description="A short introduction to Marco Sèvegrand.">
  <article class="about">
    <h1 class="visually-hidden">About</h1>

    <header class="about-head">
      <div class="about-identity">
        <img
          class="about-photo"
          src="/images/me.png"
          alt="Portrait of Marco Sèvegrand"
          loading="eager"
        />

        <p class="about-location">{SITE.location}</p>

        <div class="contact-list" aria-label="Contact links">
          {
            SOCIALS.map((social) => (
              <a class="contact-link" href={social.href} rel="me noopener" target="_blank">
                <ContactIcon label={social.label} />
                <span>{social.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="content about-copy">
        <p>
          <strong>Software Engineering graduate</strong> now pursuing a <strong
            >Master's in Cybersecurity</strong
          >.
        </p>
        <p>
          I'm focusing on <span class="text-mark">cloud security</span> and expanding my knowledge of
          cloud-native technologies, with a solid grounding in{' '}
          <span class="text-mark">infrastructure</span> and{' '}
          <span class="text-mark">application security</span>. I can architect, build and defend
          systems end to end.
        </p>
        <p>
          I use AI to speed up exploration and prototyping, but I don't blind-copy paste. I take full
          ownership of whatever I ship.
        </p>
        <p>Outside of tech, it's mostly the gym, chess and philosophy.</p>
      </div>
    </header>

    <section class="section-block timeline-section" id="experience">
      <div class="section-heading">
        <p class="section-label">Experience</p>
      </div>

      <ol class="timeline">
        {experience.map((entry) => <TimelineEntry entry={entry} />)}
      </ol>

      {
        linkedIn && (
          <p class="section-cta">
            <a href={linkedIn} target="_blank" rel="noopener">
              See the full experience on LinkedIn ↗
            </a>
          </p>
        )
      }
    </section>

    <section class="section-block timeline-section" id="education">
      <div class="section-heading">
        <p class="section-label">Education</p>
      </div>

      <ol class="timeline">
        {education.map((entry) => <TimelineEntry entry={entry} />)}
      </ol>
    </section>

    <CertificationLibrary />
  </article>
</Base>
