---
import Base from '../layouts/Base.astro';
import ContactIcon from '../components/ContactIcon.astro';
import CertificationLibrary from '../components/CertificationLibrary.astro';
import { getCollection } from 'astro:content';
import { SOCIALS, CONTACTS } from '../config';

const timeline = (await getCollection('timeline')).sort(
  (a, b) => (b.data.start ?? '').localeCompare(a.data.start ?? '') || a.data.order - b.data.order,
);
---

<Base title="About" description="A short introduction to Marco Sèvegrand.">
  <article class="about-layout">
    <div class="about-grid">
      <aside class="about-sidebar" aria-label="Photo and contact links">
        <img
          class="about-photo"
          src="/images/me.png"
          alt="Portrait of Marco Sèvegrand"
          loading="eager"
        />

        <div class="contact-list">
          {
            SOCIALS.map((social) => (
              <a class="contact-link" href={social.href} rel="me noopener" target="_blank">
                <ContactIcon label={social.label} />
                <span>{social.label}</span>
              </a>
            ))
          }
          {
            CONTACTS.map((contact) => (
              <a class="contact-link" href={contact.href}>
                <ContactIcon label={contact.label} />
                <span>{contact.label}</span>
              </a>
            ))
          }
        </div>
      </aside>

      <div class="about-main">
        <div class="content about-copy">
          <p>
            <strong>Software Engineering graduate</strong> now pursuing a <strong
              >Master's in Cybersecurity</strong
            >.
          </p>
          <p>
            My core focus is <span class="text-mark">cybersecurity</span> — from application security
            and applied cryptography to secure software development lifecycles. I also have a solid
            foundation in <span class="text-mark">infrastructure</span>, <span class="text-mark"
              >networking</span
            >
            and <span class="text-mark">systems architecture</span>, which gives me a well-rounded grasp
            of how to build and defend systems end-to-end.
          </p>
          <p>
            I use AI to speed up exploration and prototyping, but I don't blind-copy paste. I take full
            ownership of whatever I ship. Comfortable writing Go and Python when needed.
          </p>
          <p>Outside of tech: gym, chess and philosophy are likely my biggest passions.</p>
        </div>

        <section class="section-block timeline-section">
          <div class="section-heading">
            <p class="section-label">Experience &amp; Education</p>
          </div>

          <ol class="timeline">
            {
              timeline.map((item) => (
                <li class:list={['timeline-entry', `is-${item.data.status}`, `is-${item.data.kind}`]}>
                  <span class="timeline-node" aria-hidden="true" />
                  <div class="timeline-panel">
                    <details class="timeline-item">
                      <summary>
                        <span class="timeline-when">
                          <time>{item.data.date}</time>
                          <span class="timeline-state">
                            {item.data.status === 'ongoing' ? 'Ongoing' : 'Completed'}
                          </span>
                        </span>
                        <span class="timeline-heading">
                          <span class="timeline-title">{item.data.title}</span>
                          <span class="timeline-org">{item.data.org}</span>
                        </span>
                        <span class="timeline-arrow" aria-hidden="true">
                          ⌄
                        </span>
                      </summary>
                      <div class="timeline-details">
                        {item.data.details.map((detail) => (
                          <p>{detail}</p>
                        ))}
                        {item.data.href && (
                          <a class="timeline-link" href={item.data.href} target="_blank" rel="noopener">
                            {item.data.org} ↗
                          </a>
                        )}
                      </div>
                    </details>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <CertificationLibrary />
      </div>
    </div>
  </article>
</Base>
