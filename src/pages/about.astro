---
import Base from '../layouts/Base.astro';
import ContactIcon from '../components/ContactIcon.astro';
import CertificationLibrary from '../components/CertificationLibrary.astro';
import { getCollection } from 'astro:content';
import { SOCIALS, SITE } from '../config';

const timeline = (await getCollection('timeline')).sort(
  (a, b) => (b.data.start ?? '').localeCompare(a.data.start ?? '') || a.data.order - b.data.order,
);

const statusLabel = (status?: string) => (status === 'ongoing' ? 'Ongoing' : 'Completed');

// Placeholder artwork: initials of the org, skipping connector words.
const SKIP_WORDS = new Set(['of', 'the', 'and', 'at', 'for']);
function monogram(name: string): string {
  const words = name.split(/[\s-]+/).filter((word) => word && !SKIP_WORDS.has(word.toLowerCase()));
  const initials = words.slice(0, 2).map((word) => word[0]);
  return (initials.join('') || name.slice(0, 1)).toUpperCase();
}
---

<Base title="About" description="A short introduction to Marco Sèvegrand.">
  <article class="about-layout">
    <div class="about-grid">
      <aside class="about-sidebar" aria-label="Photo and contact links">
        <img
          class="about-photo"
          src="/images/me.png"
          alt="Portrait of Marco Sèvegrand"
          loading="eager"
        />

        <p class="about-location">{SITE.location}</p>

        <div class="contact-list">
          {
            SOCIALS.map((social) => (
              <a class="contact-link" href={social.href} rel="me noopener" target="_blank">
                <ContactIcon label={social.label} />
                <span>{social.label}</span>
              </a>
            ))
          }
        </div>
      </aside>

      <div class="about-main">
        <div class="content about-copy">
          <p>
            <strong>Software Engineering graduate</strong> now pursuing a <strong
              >Master's in Cybersecurity</strong
            >.
          </p>
          <p>
            My core focus is <span class="text-mark">cybersecurity</span> — from application security
            and applied cryptography to secure software development lifecycles. I also have a solid
            foundation in <span class="text-mark">infrastructure</span>, <span class="text-mark"
              >networking</span
            >
            and <span class="text-mark">systems architecture</span>, which gives me a well-rounded grasp
            of how to build and defend systems end-to-end.
          </p>
          <p>
            I use AI to speed up exploration and prototyping, but I don't blind-copy paste. I take full
            ownership of whatever I ship. Comfortable writing Go and Python when needed.
          </p>
          <p>Outside of tech: gym, chess and philosophy are likely my biggest passions.</p>
        </div>

        <section class="section-block timeline-section">
          <div class="section-heading">
            <p class="section-label">Experience &amp; Education</p>
          </div>

          <ol class="timeline">
            {
              timeline.map((entry) => {
                const roles = entry.data.roles;
                const isGroup = roles.length > 1;
                const primary = roles[0];
                const rest = roles.slice(1);
                const collapsed = rest.filter((role) => role.collapsed).length;
                const main = isGroup && primary ? primary : entry.data;

                return (
                  <li class:list={['timeline-entry', `is-${entry.data.status}`, `is-${entry.data.kind}`]}>
                    <span class="timeline-logo" aria-hidden="true">
                      {entry.data.logo ? (
                        <img src={entry.data.logo} alt="" loading="lazy" />
                      ) : (
                        monogram(entry.data.org)
                      )}
                    </span>

                    <div class="timeline-panel">
                      <details class="timeline-item">
                        <summary>
                          <span class="timeline-when">
                            <time>{main.date}</time>
                            <span class="timeline-state">{statusLabel(main.status)}</span>
                          </span>
                          <span class="timeline-heading">
                            <span class="timeline-title">{main.title}</span>
                            <span class="timeline-org">{entry.data.org}</span>
                          </span>
                          <span class="timeline-arrow" aria-hidden="true">
                            ⌄
                          </span>
                        </summary>

                        <div class="timeline-details">
                          {isGroup ? (
                            <>
                              {(entry.data.meta || entry.data.location) && (
                                <p class="timeline-group-meta">
                                  {entry.data.meta}
                                  {entry.data.meta && entry.data.location ? ' · ' : ''}
                                  {entry.data.location}
                                </p>
                              )}
                              <ul class="role-list" data-role-list>
                                {rest.map((role) => (
                                  <li class:list={['role', role.collapsed && 'is-collapsed']}>
                                    <p class="role-title">{role.title}</p>
                                    <p class="role-meta">
                                      <time>{role.date}</time>
                                      {role.duration && <span>{role.duration}</span>}
                                      {role.employment && <span>{role.employment}</span>}
                                      <span class:list={['role-state', `is-${role.status}`]}>
                                        {statusLabel(role.status)}
                                      </span>
                                    </p>
                                    {role.details.map((detail) => (
                                      <p class="role-detail">{detail}</p>
                                    ))}
                                  </li>
                                ))}
                              </ul>
                              {collapsed > 0 && (
                                <button
                                  type="button"
                                  class="role-toggle"
                                  data-role-toggle
                                  data-count={collapsed}>
                                  Show {collapsed} more role{collapsed > 1 ? 's' : ''}
                                </button>
                              )}
                            </>
                          ) : (
                            entry.data.details.map((detail) => <p>{detail}</p>)
                          )}
                        </div>
                      </details>
                    </div>
                  </li>
                );
              })
            }
          </ol>
        </section>

        <CertificationLibrary />
      </div>
    </div>
  </article>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-role-toggle]')) {
    const list = button.closest('.timeline-details')?.querySelector<HTMLElement>('[data-role-list]');
    if (!list) continue;

    const count = Number(button.dataset.count ?? '0');
    const expanded = () => list.classList.contains('show-collapsed');

    button.addEventListener('click', () => {
      list.classList.toggle('show-collapsed');
      button.textContent = expanded()
        ? 'Show fewer roles'
        : `Show ${count} more role${count > 1 ? 's' : ''}`;
    });
  }
</script>
