---
import Base from '../layouts/Base.astro';
import PostItem from '../components/PostItem.astro';
import { getCollection } from 'astro:content';
import { byDateDesc, postExcerpt } from '../lib/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(byDateDesc).slice(0, 5);
---

<Base isHome>
  <section class="hero-block" aria-labelledby="intro-title">
    <div class="hero-copy">
      <h1 id="intro-title">Hi, I'm Marco.</h1>
      <div class="intro-copy">
        <p>
          I'm a software engineering graduate working on a master's in cybersecurity. This is where I
          write about security, infrastructure and the things I'm figuring out along the way.
        </p>
        <p>
          There's a bit more <a href="/about/">about me</a> if you're curious, plus my <a
            href="/about/#experience">experience</a
          > and <a href="/about/#certifications">certifications, courses and badges</a>. And last but not
          least, do take a look at my <a href="/projects/">featured projects</a>.
        </p>
      </div>
      <p class="hero-email">
        The best way to reach me is <a href="mailto:contact@marcosev.com">contact@marcosev.com</a>
      </p>
    </div>
  </section>

  <section class="section-block" aria-labelledby="recent-posts-title">
    <div class="section-heading">
      <h2 id="recent-posts-title">Recent posts</h2>
      <a class="section-link" href="/blog/">All posts</a>
    </div>
    {
      posts.length > 0 ? (
        <div class="post-list compact-list">
          {posts.map((post) => (
            <PostItem
              title={post.data.title}
              href={`/blog/${post.id}/`}
              date={post.data.date}
              tags={post.data.tags}
              summary={postExcerpt(post)}
            />
          ))}
        </div>
      ) : (
        <p class="muted">No posts yet.</p>
      )
    }
  </section>
</Base>
