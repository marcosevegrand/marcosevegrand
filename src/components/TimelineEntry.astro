---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'timeline'>;
}

const { entry } = Astro.props;

const roles = entry.data.roles;
const primary = roles[0];
const rest = roles.slice(1);

// Complex entries summarise with their most recent role; simple entries use
// their own title/date/meta.
const main = primary ?? entry.data;
const when = main.date ?? entry.data.date;
const title = main.title ?? entry.data.title;
const status = main.status ?? entry.data.status;

const statusLabel = (value?: string) => (value === 'ongoing' ? 'Ongoing' : 'Completed');

// employment type · total time · style (job location is intentionally omitted)
type Meta = { employment?: string; duration?: string; style?: string };
const metaOf = (value: Meta) =>
  [value.employment, value.duration, value.style].filter(Boolean).join(' · ');

const meta = metaOf(main);
---

<li class:list={['timeline-entry', `is-${entry.data.status}`, `is-${entry.data.kind}`]}>
  <span class="timeline-logo" aria-hidden="true">
    {
      entry.data.logo ? (
        <img src={entry.data.logo} alt="" loading="lazy" />
      ) : (
        <svg class="timeline-mark" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12.8 12.0 L12.9 12.2 L12.9 12.4 L12.9 12.6 L12.9 12.8 L12.8 13.1 L12.6 13.3 L12.4 13.5 L12.1 13.6 L11.8 13.7 L11.4 13.8 L11.1 13.7 L10.7 13.6 L10.3 13.4 L10.0 13.1 L9.7 12.7 L9.5 12.3 L9.4 11.8 L9.4 11.3 L9.5 10.8 L9.7 10.3 L9.9 9.8 L10.3 9.4 L10.8 9.0 L11.4 8.7 L12.0 8.6 L12.7 8.5 L13.3 8.6 L14.0 8.8 L14.6 9.2 L15.2 9.7 L15.7 10.3 L16.0 11.0 L16.3 11.7 L16.3 12.5 L16.3 13.4 L16.0 14.2 L15.6 15.0 L15.1 15.7 L14.4 16.3 L13.5 16.8 L12.6 17.1 L11.7 17.2 L10.7 17.1 L9.7 16.9 L8.8 16.5 L7.9 15.9 L7.2 15.1 L6.6 14.1 L6.2 13.1 L6.0 12.0 L6.0 10.8 L6.2 9.7 L6.6 8.6 L7.3 7.6 L8.1 6.7 L9.2 6.0 L10.3 5.4 L11.6 5.1 L12.9 5.1 L14.2 5.2 L15.5 5.7 L16.7 6.4 L17.7 7.3 L18.6 8.4 L19.3 9.6 L19.7 11.0 L19.8 12.5 L19.7 14.0 L19.3 15.4 L18.6 16.8 L17.7 18.0 L16.5 19.1 L15.1 19.9 L13.6 20.4 L12.0 20.7 L10.4 20.6 L8.7 20.3 L7.2 19.6 L5.8 18.6 L4.6 17.4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )
    }
  </span>

  <div class="timeline-panel">
    <div class="timeline-row">
      <span class="timeline-when">
        <time>{when}</time>
        <span class="timeline-state">{statusLabel(status)}</span>
      </span>
      <span class="timeline-heading">
        <span class="timeline-title">{title}</span>
        <span class="timeline-org">{entry.data.org}</span>
      </span>
      {meta && <span class="timeline-meta">{meta}</span>}
    </div>

    {
      rest.length > 0 && (
        <ul class="subroles">
          {rest.map((role) => (
            <li class="subrole">
              <span class="subrole-title">{role.title}</span>
              <span class="subrole-meta">
                {[role.date, metaOf(role)].filter(Boolean).join(' · ')}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>
