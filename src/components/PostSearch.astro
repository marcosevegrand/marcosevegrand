---
import { getCollection } from 'astro:content';
import PostItem from './PostItem.astro';
import { byDateDesc, postExcerpt } from '../lib/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(byDateDesc);
---

<section class="search-panel" aria-labelledby="post-search-title">
  <label id="post-search-title" for="post-filter">Search posts</label>
  <input
    id="post-filter"
    type="search"
    placeholder="Search title, summary, or tags"
    autocomplete="off"
    data-pagefind-search
  />
</section>

<div class="post-list" data-search-results>
  {
    posts.length > 0 ? (
      posts.map((post) => (
        <PostItem
          title={post.data.title}
          href={`/blog/${post.id}/`}
          date={post.data.date}
          tags={post.data.tags}
          summary={postExcerpt(post)}
        />
      ))
    ) : (
      <p class="muted">No posts yet.</p>
    )
  }
</div>

<script>
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
  }

  interface PagefindSearchResponse {
    results: Array<{ data: () => Promise<PagefindResultData> }>;
  }

  interface PagefindModule {
    options(options: Record<string, unknown>): Promise<void>;
    search(term: string): Promise<PagefindSearchResponse>;
  }

  const input = document.querySelector<HTMLInputElement>('[data-pagefind-search]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');

  if (input && results) {
    const initial = results.innerHTML;
    // Pagefind's runtime module only exists after a build; keep the specifier in
    // a variable so neither TypeScript nor Vite tries to resolve it at dev time.
    const modulePath = '/pagefind/pagefind.js';
    let pagefind: PagefindModule | null = null;

    const escapeHTML = (value: string) =>
      value.replace(/[&<>'"]/g, (char) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char] as string,
      );

    const load = async (): Promise<PagefindModule> => {
      pagefind ??= (await import(/* @vite-ignore */ modulePath)) as PagefindModule;
      return pagefind;
    };

    const render = (items: PagefindResultData[]) => {
      if (!items.length) {
        results.innerHTML = '<p class="muted">No posts matched your search.</p>';
        return;
      }

      results.innerHTML = items
        .map(
          (item) => `
          <article class="post-item">
            <div class="post-meta"><time>${escapeHTML(item.meta.date ?? '')}</time></div>
            <h3><a href="${escapeHTML(item.url)}">${escapeHTML(item.meta.title ?? '')}</a></h3>
            <p>${item.excerpt}</p>
          </article>`,
        )
        .join('');
    };

    input.addEventListener('input', async () => {
      const query = input.value.trim();
      if (!query) {
        results.innerHTML = initial;
        return;
      }

      try {
        const pf = await load();
        await pf.options({ excerptLength: 24 });
        const search = await pf.search(query);
        const items = await Promise.all(search.results.slice(0, 20).map((result) => result.data()));
        render(items);
      } catch {
        results.innerHTML = '<p class="muted">Search index could not be loaded.</p>';
      }
    });
  }
</script>
