---
import { formatDate } from '../config';

interface Props {
  title: string;
  href: string;
  date?: Date;
  tags?: string[];
  summary?: string;
}

const { title, href, date, tags = [], summary } = Astro.props;
---

<article class="post-item">
  {date && <p class="post-kind"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></p>}
  <h3><a href={href}>{title}</a></h3>
  {summary && <p class="post-summary">{summary}</p>}
  {tags.length > 0 && <p class="post-tags">{tags.join(' · ')}</p>}
</article>
